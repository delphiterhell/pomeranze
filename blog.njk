---
layout: base.njk
title: Blog
description: Note di stagione, consigli di coltivazione e storie dal campo di Clelia.
permalink: /blog.html
---

{% block content %}

  <section class="sezione sezione-sfondo-verde" aria-labelledby="titolo-blog">
    <div class="container">
      <div class="sezione-header rivela">
        <h1 id="titolo-blog">Dal campo</h1>
        <p>Note di stagione, piccoli esperimenti, qualche consiglio e tante storie dal mio orticello fiorito.</p>
      </div>
    </div>
  </section>

  <section class="sezione sezione-sfondo-bianco" aria-label="Articoli del blog">
    <div class="container">

      <div class="blog-griglia">
        {% for post in collections.blog %}
        <article class="blog-card rivela">
          {% if post.data.coverImage %}
          <img src="{{ post.data.coverImage | imgCDN(600) }}" alt="{{ post.data.title }}" class="blog-card-img">
          {% endif %}
          <div class="blog-card-body">
            <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
              {% if post.data.tags and post.data.tags | length %}
              <span class="tag">{{ post.data.tags[0] }}</span>
              {% endif %}
              <span style="font-size:0.75rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--oliva);opacity:0.7;">{{ post.date | dataItaliana }}</span>
            </div>
            <h2 class="blog-card-titolo"><a href="{{ post.url }}" style="color:inherit;text-decoration:none;">{{ post.data.title }}</a></h2>
            {% if post.data.excerpt %}<p class="blog-card-testo">{{ post.data.excerpt }}</p>{% endif %}
            <a href="{{ post.url }}" class="link-leggi">Leggi →</a>
          </div>
        </article>
        {% else %}
        <p style="opacity:0.6;">Nessun articolo ancora. Torna presto!</p>
        {% endfor %}
      </div>

    </div>
  </section>

{% endblock %}
