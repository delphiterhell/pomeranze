---
layout: base.njk
title: Blog
description: Note di stagione, consigli di coltivazione e storie dal campo di Clelia.
permalink: /blog.html
---

{% block head %}
<style>
  .articoli-lista {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .articolo-card {
    background-color: var(--verde-chiaro);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(52,78,65,0.08);
    display: grid;
    grid-template-columns: 1fr;
    transition: transform var(--transizione), box-shadow var(--transizione);
    text-decoration: none;
    color: inherit;
  }
  @media (min-width: 600px) {
    .articolo-card { grid-template-columns: 220px 1fr; }
  }
  .articolo-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(52,78,65,0.14);
  }
  .articolo-card-img {
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  @media (min-width: 600px) {
    .articolo-card-img { aspect-ratio: auto; }
  }
  .articolo-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .articolo-card-corpo {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .articolo-card-corpo h2 { font-size: 1.3rem; color: var(--testo); margin-bottom: 0; }
  .articolo-card-corpo p {
    font-size: 0.95rem;
    opacity: 0.8;
    max-width: none;
    margin-bottom: 0;
  }
  .articolo-card-footer {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
{% endblock %}

{% block content %}

  <section class="sezione sezione-sfondo-verde" aria-labelledby="titolo-blog">
    <div class="container">
      <div class="sezione-header rivela">
        <h1 id="titolo-blog">Dal campo</h1>
        <p>Note di stagione, piccoli esperimenti, qualche consiglio e tante storie dal mio orticello fiorito.</p>
      </div>
    </div>
  </section>

  <section class="sezione sezione-sfondo-bianco" aria-label="Articoli del blog">
    <div class="container">
      <div class="articoli-lista">

        {% for post in collections.blog %}
        <a href="{{ post.url }}" class="articolo-card rivela">
          <div class="articolo-card-img">
            {% if post.data.coverImage %}
              <img src="{{ post.data.coverImage }}" alt="{{ post.data.title }}">
            {% else %}
              <img src="/images/articolouno.webp" alt="{{ post.data.title }}">
            {% endif %}
          </div>
          <div class="articolo-card-corpo">
            <div>
              {% if post.data.tags and post.data.tags | length %}
                <span class="tag">{{ post.data.tags[0] }}</span>
              {% endif %}
              <span class="card-data" style="margin-left:0.5rem;">{{ post.date | dataItaliana }}</span>
            </div>
            <h2>{{ post.data.title }}</h2>
            {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
            <div class="articolo-card-footer">
              <span style="font-size:0.85rem;opacity:0.6;">Leggi l'articolo</span>
              <span class="btn btn-outline btn-piccolo">Leggi tutto →</span>
            </div>
          </div>
        </a>
        {% else %}
        <p style="opacity:0.6;">Nessun articolo ancora. Torna presto!</p>
        {% endfor %}

      </div>
    </div>
  </section>

{% endblock %}
